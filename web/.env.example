# Copy to web/.env for local development. In development the Shopify CLI sets
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SCOPES, HOST and BACKEND_PORT for you;
# in production set every required variable on your host.

# --- Required -------------------------------------------------------------------
# URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/

# Required in production (provided by the Shopify CLI in development):
# SHOPIFY_API_KEY=
# SHOPIFY_API_SECRET=
# SCOPES=write_products
# HOST=https://your-app.example.com

# --- Optional (defaults shown) -------------------------------------------------
# MONGODB_DB_NAME=n_helixo_timer
# PORT=3000                     # BACKEND_PORT takes precedence when set
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent (debug in development)
# TRUST_PROXY=loopback,linklocal,uniquelocal   # true | false | hop count | address list

# Fit these to your platform's grace period before it force-kills the process:
# SHUTDOWN_TIMEOUT_MS=15000
# SHUTDOWN_DELAY_MS=5000        # 0 in development
